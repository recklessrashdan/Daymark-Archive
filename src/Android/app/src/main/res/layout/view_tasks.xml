<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="24dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TASK LIBRARY"
                    android:textColor="?attr/day_primary_dark" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                    android:text="All tasks" android:textColor="?attr/day_text" android:textSize="28sp" android:textStyle="bold" />
                <TextView android:id="@+id/tasks_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="?attr/day_muted" android:textSize="12sp" />
            </LinearLayout>
            <Button android:id="@+id/tasks_new" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/bg_primary_button" android:minHeight="0dp" android:text="+ New"
                android:textAllCaps="false" android:textColor="@android:color/white" android:textSize="12sp"
                android:textStyle="bold" android:paddingStart="14dp" android:paddingEnd="14dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:background="@drawable/bg_card" android:orientation="vertical" android:padding="14dp">
            <EditText android:id="@+id/tasks_search" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_input" android:hint="Search title, notes or category..."
                android:padding="11dp" android:textColor="?attr/day_text" android:textColorHint="?attr/day_muted"
                android:textSize="13sp" android:importantForAutofill="no" android:inputType="text" android:maxLines="1" />

            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:scrollbars="none">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/filter_all" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:minHeight="0dp" android:background="@drawable/bg_chip_selected" android:text="All"
                        android:textAllCaps="false" android:textColor="@android:color/white" android:textSize="11sp" />
                    <Button android:id="@+id/filter_active" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="6dp" android:minHeight="0dp" android:background="@drawable/bg_chip"
                        android:text="Active" android:textAllCaps="false" android:textColor="?attr/day_muted" android:textSize="11sp" />
                    <Button android:id="@+id/filter_completed" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="6dp" android:minHeight="0dp" android:background="@drawable/bg_chip"
                        android:text="Done" android:textAllCaps="false" android:textColor="?attr/day_muted" android:textSize="11sp" />
                    <Button android:id="@+id/filter_high" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="6dp" android:minHeight="0dp" android:background="@drawable/bg_chip"
                        android:text="High" android:textAllCaps="false" android:textColor="?attr/day_muted" android:textSize="11sp" />
                    <Button android:id="@+id/filter_overdue" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="6dp" android:minHeight="0dp" android:background="@drawable/bg_chip"
                        android:text="Overdue" android:textAllCaps="false" android:textColor="?attr/day_muted" android:textSize="11sp" />
                    <Button android:id="@+id/filter_upcoming" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="6dp" android:minHeight="0dp" android:background="@drawable/bg_chip"
                        android:text="Upcoming" android:textAllCaps="false" android:textColor="?attr/day_muted" android:textSize="11sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:layout_marginTop="12dp">
                <Spinner android:id="@+id/tasks_category" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:background="@drawable/bg_input" android:prompt="@string/category_prompt" />
                <Spinner android:id="@+id/tasks_sort" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/bg_input"
                    android:entries="@array/task_sorts" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:layout_marginTop="10dp" android:gravity="center_vertical">
                <EditText android:id="@+id/tasks_quick" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:background="@drawable/bg_input" android:hint="Quick add a task..."
                    android:padding="10dp" android:textColor="?attr/day_text" android:textColorHint="?attr/day_muted"
                    android:textSize="12sp" android:importantForAutofill="no" android:inputType="text" android:maxLines="1" />
                <Button android:id="@+id/tasks_quick_add" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:minHeight="0dp" android:background="@drawable/bg_primary_button"
                    android:text="Add" android:textAllCaps="false" android:textColor="@android:color/white" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:layout_marginTop="18dp">
            <TextView android:id="@+id/tasks_group" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Everything" android:textColor="?attr/day_text"
                android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/tasks_result" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0 tasks" android:textColor="?attr/day_muted" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/tasks_list" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
        <TextView android:id="@+id/tasks_empty" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="No tasks match this view. Try a different filter or create a task."
            android:textColor="?attr/day_muted" android:textSize="12sp" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
