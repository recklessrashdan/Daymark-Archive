<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PREFERENCES"
            android:textColor="?attr/day_primary_dark" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
            android:text="Settings" android:textColor="?attr/day_text" android:textSize="28sp" android:textStyle="bold" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Appearance"
                android:textColor="?attr/day_text" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="Light, dark, or follow your system." android:textColor="?attr/day_muted" android:textSize="12sp" />
            <RadioGroup android:id="@+id/theme_group" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="12dp">
                <RadioButton android:id="@+id/theme_light" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Light" android:textColor="?attr/day_text" android:textSize="12sp" />
                <RadioButton android:id="@+id/theme_dark" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:text="Dark" android:textColor="?attr/day_text" android:textSize="12sp" />
                <RadioButton android:id="@+id/theme_system" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:text="System" android:textColor="?attr/day_text" android:textSize="12sp" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Data management"
                android:textColor="?attr/day_text" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="All data is stored locally on this device." android:textColor="?attr/day_muted" android:textSize="12sp" />
            <TextView android:id="@+id/settings_storage" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:textColor="?attr/day_muted" android:textSize="11sp" />
            <TextView android:id="@+id/settings_db_path" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:textColor="?attr/day_muted" android:textSize="10sp" />
            <Button android:id="@+id/settings_backup" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:background="@drawable/bg_secondary_button"
                android:text="Create backup copy" android:textAllCaps="false" android:textColor="?attr/day_primary_dark" android:textSize="12sp" />
            <Button android:id="@+id/clear_data" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:background="@drawable/bg_secondary_button" android:text="Clear all data"
                android:textAllCaps="false" android:textColor="@color/danger" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="About Daymark"
                android:textColor="?attr/day_text" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="Version 2.1.0 · Offline edition" android:textColor="?attr/day_text" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="Your Daily Life, Organised." android:textColor="?attr/day_muted" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="Recklessplyer · No account, no cloud, no subscription." android:textColor="?attr/day_muted" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="Data schema: V2. Migration keeps every V1 record and takes a backup first."
                android:textColor="?attr/day_muted" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
