<Window x:Class="Daymark.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Daymark.Views"
        Title="Daymark — Your Daily Life, Organised." Height="860" Width="1360"
        MinHeight="640" MinWidth="980" Background="{DynamicResource Bg}"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <Grid Margin="22,26,18,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource SurfaceAlt}" Margin="0,0,12,0">
                        <Image Source="Assets/daymark.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Daymark" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                        <TextBlock Text="Your Daily Life, Organised." Style="{StaticResource Muted}" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="WORKSPACE" Style="{StaticResource Eyebrow}" Margin="12,0,0,12"/>

                <ListBox x:Name="Nav" Grid.Row="3" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="Nav_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Tag="today" AutomationProperties.Name="Today navigation">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Today" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="tasks" AutomationProperties.Name="Tasks navigation">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE133;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Tasks" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="calendar" AutomationProperties.Name="Calendar navigation">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Calendar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="notes" AutomationProperties.Name="Notes navigation">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Notes" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="settings" AutomationProperties.Name="Settings navigation">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <StackPanel Grid.Row="4">
                    <Border Background="{DynamicResource PrimarySoft}" CornerRadius="14" Padding="15">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource PrimaryDark}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="LOCAL &amp; PRIVATE" Style="{StaticResource Eyebrow}"/>
                            </StackPanel>
                            <TextBlock Text="Everything stays on this device." Foreground="{DynamicResource Text}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,9,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Daymark 2.1.0 · Recklessplyer" Style="{StaticResource Muted}" FontSize="10" Margin="6,14,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <ContentControl x:Name="ContentHost" Margin="0"/>
            <Border x:Name="Toast" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,28" Background="{DynamicResource Text}" CornerRadius="12" Padding="18,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastText" Foreground="{DynamicResource Bg}" FontSize="13" VerticalAlignment="Center"/>
                    <Button x:Name="UndoButton" Content="Undo" Style="{StaticResource QuietButton}" Foreground="{DynamicResource Primary}"
                            Margin="18,-6,-6,-6" Click="Undo_Click" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
