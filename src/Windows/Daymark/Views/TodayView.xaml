<UserControl x:Class="Daymark.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Daymark.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="38,32,38,44">
        <StackPanel MaxWidth="1240" HorizontalAlignment="Left" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="DateLine" Style="{StaticResource Eyebrow}"/>
                    <TextBlock x:Name="Greeting" Style="{StaticResource H1}" Margin="0,8,0,0"/>
                    <TextBlock Text="A clear plan makes a calm day." Style="{StaticResource Muted}" Margin="0,7,0,0" FontSize="13"/>
                </StackPanel>
                <Button Grid.Column="1" Content="＋  New task" Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Center" Click="NewTask_Click" Padding="20,12" AutomationProperties.Name="New task"/>
            </Grid>

            <!-- Progress + weekly rhythm -->
            <Border Style="{StaticResource Card}" Margin="0,26,0,0" Padding="26,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/><ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="112" Height="112">
                        <controls:ProgressRing x:Name="Ring" Percent="0"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="PercentText" Text="0%" FontSize="27" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" HorizontalAlignment="Center"/>
                            <TextBlock Text="complete" Style="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Today's progress" Style="{StaticResource H2}"/>
                        <TextBlock x:Name="ProgressNote" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <StackPanel Width="105"><TextBlock Text="TOTAL" Style="{StaticResource Muted}" FontSize="10"/>
                                <TextBlock x:Name="TotalText" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,3,0,0"/></StackPanel>
                            <StackPanel Width="120"><TextBlock Text="COMPLETED" Style="{StaticResource Muted}" FontSize="10"/>
                                <TextBlock x:Name="DoneText" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource Success}" Margin="0,3,0,0"/></StackPanel>
                            <StackPanel Width="110"><TextBlock Text="REMAINING" Style="{StaticResource Muted}" FontSize="10"/>
                                <TextBlock x:Name="LeftText" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryDark}" Margin="0,3,0,0"/></StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <Rectangle Grid.Column="3" Width="1" Fill="{DynamicResource Border}" VerticalAlignment="Stretch" Margin="0,6"/>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="WEEKLY RHYTHM" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="WeekTotal" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <StackPanel x:Name="WeekBars" Orientation="Horizontal" Height="72" Margin="0,14,0,0" VerticalAlignment="Bottom"/>
                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="Completion streak" Style="{StaticResource Muted}" FontSize="11"/>
                            <TextBlock x:Name="StreakText" Style="{StaticResource H3}" HorizontalAlignment="Right" Foreground="{DynamicResource AmberDark}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- At-a-glance insight tiles -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Click="Overdue_Click" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="OVERDUE" Style="{StaticResource Muted}" FontSize="10"/>
                        <TextBlock x:Name="OverdueCount" Text="0" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Danger}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Click="Upcoming_Click" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="DUE IN 7 DAYS" Style="{StaticResource Muted}" FontSize="10"/>
                        <TextBlock x:Name="UpcomingCount" Text="0" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AmberDark}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Click="Priority_Click" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="PRIORITY FOCUS" Style="{StaticResource Muted}" FontSize="10"/>
                        <TextBlock x:Name="PriorityCount" Text="0" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryDark}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Margin="0,26,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Today's tasks" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        <Button Content="View all" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Click="ViewAll_Click"/>
                    </Grid>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="14" Padding="10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="QuickAdd" Style="{StaticResource Input}" BorderThickness="0" Height="38"
                                     Tag="Add a task for today..." KeyDown="QuickAdd_KeyDown"
                                     AutomationProperties.Name="Quick add task"/>
                            <Button Grid.Column="1" Content="Add" Style="{StaticResource PrimaryButton}" Click="QuickAdd_Click" Padding="16,8"/>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="TaskList"/>
                    <TextBlock x:Name="EmptyTasks" Text="Nothing planned yet. Add your first task above." Style="{StaticResource Muted}"
                               Margin="12,8,0,0" Visibility="Collapsed"/>

                    <TextBlock Text="Upcoming deadlines" Style="{StaticResource H2}" Margin="0,30,0,12"/>
                    <StackPanel x:Name="UpcomingList"/>
                    <TextBlock x:Name="EmptyUpcoming" Text="No deadlines in the next seven days." Style="{StaticResource Muted}"
                               Margin="6,2,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Priority focus" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                    <StackPanel x:Name="PriorityList"/>
                    <TextBlock x:Name="EmptyPriority" Text="No high-priority tasks. Enjoy the calm." Style="{StaticResource Muted}"
                               Margin="4,4,0,0" Visibility="Collapsed"/>

                    <TextBlock Text="Daily note" Style="{StaticResource H2}" Margin="0,30,0,12"/>
                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock x:Name="NoteDate" Style="{StaticResource Eyebrow}"/>
                            <TextBlock x:Name="NotePreview" Style="{StaticResource Body}" Margin="0,10,0,0" MaxHeight="96"
                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                            <Button Content="Open notes  →" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"
                                    Margin="-6,12,0,0" Click="OpenNotes_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="QUICK ACCESS" Style="{StaticResource Eyebrow}"/>
                            <Button Content="Open calendar" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"
                                    Margin="-6,10,0,0" Click="OpenCalendar_Click"/>
                            <Button Content="Browse all tasks" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"
                                    Margin="-6,2,0,0" Click="ViewAll_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
