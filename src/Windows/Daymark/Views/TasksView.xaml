<UserControl x:Class="Daymark.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="38,32,38,44">
        <StackPanel MaxWidth="1240" HorizontalAlignment="Left" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="TASK LIBRARY" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="All tasks" Style="{StaticResource H1}" Margin="0,8,0,0"/>
                    <TextBlock x:Name="CountLine" Style="{StaticResource Muted}" Margin="0,7,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="＋  New task" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Click="NewTask_Click" Padding="20,12" AutomationProperties.Name="New task"/>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,24,0,18" Padding="16,18">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Style="{StaticResource Input}" Height="42" Tag="Search tasks by title, description or category..."
                                 TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Search tasks"/>
                        <TextBlock Text="⌕" Grid.Column="1" FontSize="22" Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center" Margin="12,0,6,0" IsHitTestVisible="False"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <RadioButton Content="All" Style="{StaticResource Chip}" IsChecked="True" Tag="all" Checked="Filter_Checked"/>
                        <RadioButton Content="Active" Style="{StaticResource Chip}" Tag="active" Checked="Filter_Checked"/>
                        <RadioButton Content="Completed" Style="{StaticResource Chip}" Tag="completed" Checked="Filter_Checked"/>
                        <RadioButton Content="High priority" Style="{StaticResource Chip}" Tag="high" Checked="Filter_Checked"/>
                        <RadioButton Content="Overdue" Style="{StaticResource Chip}" Tag="overdue" Checked="Filter_Checked"/>
                        <RadioButton Content="Upcoming" Style="{StaticResource Chip}" Tag="upcoming" Checked="Filter_Checked"/>
                    </StackPanel>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Category" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CategoryBox" Width="210" Height="36" SelectionChanged="CategoryBox_Changed"
                                      AutomationProperties.Name="Filter by category"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Sort" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="SortBox" Width="170" Height="36" SelectedIndex="0" SelectionChanged="SortBox_Changed"
                                      AutomationProperties.Name="Sort tasks">
                                <ComboBoxItem Content="Smart order"/>
                                <ComboBoxItem Content="Due date"/>
                                <ComboBoxItem Content="Priority"/>
                                <ComboBoxItem Content="Recently added"/>
                                <ComboBoxItem Content="Title A–Z"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Margin="4,0,0,12">
                <TextBlock x:Name="GroupLabel" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                <TextBlock x:Name="ResultCount" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel x:Name="TaskList"/>
            <Border x:Name="EmptyText" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="14" Padding="26" Margin="0,8,0,0" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="✧" FontSize="28" Foreground="{DynamicResource Primary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="No tasks match this view." Style="{StaticResource H3}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="Try a different filter or create a new task." Style="{StaticResource Muted}" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
