<UserControl x:Class="Daymark.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="38,34,38,44">
        <StackPanel MaxWidth="1180" HorizontalAlignment="Left" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="PLAN AHEAD" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="Calendar" Style="{StaticResource H1}" Margin="0,8,0,0"/>
                    <TextBlock Text="A gentle overview of what's coming up." Style="{StaticResource Muted}" Margin="0,7,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="MonthToggle" Content="Month" Style="{StaticResource ToggleChip}" IsChecked="True" Checked="ViewMode_Checked" Unchecked="ViewMode_Unchecked"/>
                    <ToggleButton x:Name="WeekToggle" Content="Week" Style="{StaticResource ToggleChip}" Checked="ViewMode_Checked" Unchecked="ViewMode_Unchecked"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,26,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <TextBlock x:Name="MonthLabel" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="‹" Style="{StaticResource SecondaryButton}" Width="36" FontSize="18"
                                        Padding="0,4" Click="Prev_Click" AutomationProperties.Name="Previous month"/>
                                <Button Content="Today" Style="{StaticResource QuietButton}" Margin="8,0" Click="Today_Click"/>
                                <Button Content="›" Style="{StaticResource SecondaryButton}" Width="36" FontSize="18"
                                        Padding="0,4" Click="Next_Click" AutomationProperties.Name="Next month"/>
                            </StackPanel>
                        </Grid>
                        <UniformGrid Columns="7" Margin="0,0,0,8">
                            <TextBlock Text="MON" Style="{StaticResource Muted}" HorizontalAlignment="Center" FontSize="10"/>
                            <TextBlock Text="TUE" Style="{StaticResource Muted}" HorizontalAlignment="Center" FontSize="10"/>
                            <TextBlock Text="WED" Style="{StaticResource Muted}" HorizontalAlignment="Center" FontSize="10"/>
                            <TextBlock Text="THU" Style="{StaticResource Muted}" HorizontalAlignment="Center" FontSize="10"/>
                            <TextBlock Text="FRI" Style="{StaticResource Muted}" HorizontalAlignment="Center" FontSize="10"/>
                            <TextBlock Text="SAT" Style="{StaticResource Muted}" HorizontalAlignment="Center" FontSize="10"/>
                            <TextBlock Text="SUN" Style="{StaticResource Muted}" HorizontalAlignment="Center" FontSize="10"/>
                        </UniformGrid>
                        <Grid x:Name="CalendarGrid" Height="440"/>
                        <Grid x:Name="WeekPanel" Height="440" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="SELECTED DAY" Style="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SelectedDateLabel" Style="{StaticResource H2}" Margin="0,8,0,0"/>
                            <TextBlock x:Name="DaySummary" Style="{StaticResource Muted}" Margin="0,6,0,16"/>
                            <StackPanel x:Name="DayTaskList"/>
                            <TextBlock x:Name="EmptyDay" Text="No tasks due on this day." Style="{StaticResource Muted}" Visibility="Collapsed" Margin="2,6,0,0"/>
                            <Button Content="+  Add task for this day" Style="{StaticResource SecondaryButton}" Margin="0,18,0,0"
                                    Click="AddForDay_Click" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="AT A GLANCE" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0" Text="Dots mark days with tasks; amber marks overdue work. Select any day to see and add its tasks. Due dates are stored locally in ISO format and stay in sync with the task list."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
