<UserControl x:Class="Daymark.Views.TaskRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="74" Margin="0,0,0,9">
    <Border x:Name="Card" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="15" Padding="15,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="2" Width="3" Margin="0,2,12,2"
                    Background="{DynamicResource PriorityMedium}" x:Name="PriorityBar" VerticalAlignment="Stretch"/>

            <CheckBox Grid.Column="1" Style="{StaticResource RoundCheck}" VerticalAlignment="Center"
                      x:Name="Check" Checked="Check_Changed" Unchecked="Check_Changed" Margin="0,0,14,0" AutomationProperties.Name="Complete task"/>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TitleText" Style="{StaticResource H3}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Border x:Name="PriorityPill" CornerRadius="9" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource AmberSoft}" Visibility="Collapsed">
                        <TextBlock x:Name="PriorityPillText" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AmberDark}"/>
                    </Border>
                    <Border x:Name="DuePill" CornerRadius="9" Padding="8,2" Margin="7,0,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource PrimarySoft}" Visibility="Collapsed">
                        <TextBlock x:Name="DuePillText" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryDark}"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="MetaText" Style="{StaticResource Muted}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Button Grid.Column="3" Content="Edit" Style="{StaticResource QuietButton}" VerticalAlignment="Center"
                    Click="Edit_Click" Margin="4,0,2,0" AutomationProperties.Name="Edit task"/>
            <Button Grid.Column="4" Content="Delete" Style="{StaticResource QuietButton}" VerticalAlignment="Center"
                    Click="Delete_Click" Foreground="{DynamicResource Danger}" AutomationProperties.Name="Delete task"/>
        </Grid>
    </Border>
</UserControl>
