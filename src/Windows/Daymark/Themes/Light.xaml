<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Daymark V2 — Midnight / Porcelain / Electric Teal / Warm Amber -->
    <SolidColorBrush x:Key="Bg" Color="#F4F6F8"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#EAEFF3"/>
    <SolidColorBrush x:Key="SurfaceElevated" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Text" Color="#151C2C"/>
    <SolidColorBrush x:Key="TextMuted" Color="#586778"/>
    <SolidColorBrush x:Key="Border" Color="#DDE4EB"/>
    <SolidColorBrush x:Key="Primary" Color="#19B8A5"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#12A08F"/>
    <SolidColorBrush x:Key="PrimarySoft" Color="#DFF4F0"/>
    <SolidColorBrush x:Key="PrimaryDark" Color="#0B7E72"/>
    <SolidColorBrush x:Key="OnPrimary" Color="#052A25"/>
    <SolidColorBrush x:Key="Amber" Color="#F2B65D"/>
    <SolidColorBrush x:Key="AmberSoft" Color="#FDF1DD"/>
    <SolidColorBrush x:Key="AmberDark" Color="#8A5A12"/>
    <SolidColorBrush x:Key="PriorityHigh" Color="#D1556B"/>
    <SolidColorBrush x:Key="PriorityMedium" Color="#B87A1E"/>
    <SolidColorBrush x:Key="PriorityLow" Color="#0B7E72"/>
    <SolidColorBrush x:Key="Danger" Color="#C4445B"/>
    <SolidColorBrush x:Key="Success" Color="#0B7E72"/>
