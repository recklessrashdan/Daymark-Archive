<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Daymark V2 dark palette: midnight surfaces, teal accents, amber highlights -->
    <SolidColorBrush x:Key="Bg" Color="#0F1522"/>
    <SolidColorBrush x:Key="Surface" Color="#151C2C"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#1E2939"/>
    <SolidColorBrush x:Key="SurfaceElevated" Color="#1B2436"/>
    <SolidColorBrush x:Key="Text" Color="#F4F6F8"/>
    <SolidColorBrush x:Key="TextMuted" Color="#A6B3C2"/>
    <SolidColorBrush x:Key="Border" Color="#2B384B"/>
    <SolidColorBrush x:Key="Primary" Color="#19B8A5"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#3BCCBB"/>
    <SolidColorBrush x:Key="PrimarySoft" Color="#163E3A"/>
    <SolidColorBrush x:Key="PrimaryDark" Color="#6AD9CA"/>
    <SolidColorBrush x:Key="OnPrimary" Color="#052A25"/>
    <SolidColorBrush x:Key="Amber" Color="#F2B65D"/>
    <SolidColorBrush x:Key="AmberSoft" Color="#3A2E1B"/>
    <SolidColorBrush x:Key="AmberDark" Color="#F2C987"/>
    <SolidColorBrush x:Key="PriorityHigh" Color="#FF8599"/>
    <SolidColorBrush x:Key="PriorityMedium" Color="#F2B65D"/>
    <SolidColorBrush x:Key="PriorityLow" Color="#6AD9CA"/>
    <SolidColorBrush x:Key="Danger" Color="#FF8599"/>
    <SolidColorBrush x:Key="Success" Color="#6AD9CA"/>
    <SolidColorBrush x:Key="Overlay" Color="#CC080D18"/>
    <SolidColorBrush x:Key="ShadowColor" Color="#000000"/>
</ResourceDictionary>
